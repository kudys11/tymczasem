diff -ruN orig/Makefile work/Makefile
--- orig/Makefile	1970-01-01 00:00:00.000000000 +0000
+++ work/Makefile	2026-06-15 13:15:09.859275809 +0000
@@ -0,0 +1,31 @@
+PYTHON ?= python
+PIP ?= pip
+
+.PHONY: install install-dev test test-sqlite check lint format migrate runserver
+
+install:
+	$(PIP) install -r requirements.txt
+
+install-dev:
+	$(PIP) install -r requirements-dev.txt
+
+test:
+	DJANGO_USE_SQLITE=1 DJANGO_DEBUG=1 DJANGO_SECRET_KEY=test-secret-key CELERY_TASK_ALWAYS_EAGER=1 pytest
+
+test-sqlite: test
+
+check:
+	$(PYTHON) manage.py check
+
+lint:
+	ruff check .
+
+format:
+	black .
+	ruff check . --fix
+
+migrate:
+	$(PYTHON) manage.py migrate
+
+runserver:
+	DJANGO_DEBUG=1 $(PYTHON) manage.py runserver 0.0.0.0:8000
